#!/bin/sh
# @name ADAIR fire truck (simulation only, rover_ackermann based)
# @type Rover
# @class Rover
#
# ADAIR 시뮬레이션 전용 소방차 (2026-10-10). 51100_gz_adair_ugv 와 같은 구조, 차량 치수·속도는 ugv/gazebo/models/adair_firetruck
# 와 ugv/profiles.py adair_firetruck (시뮬레이션 가정값 — 실차 제원 아님). 목표: 속도 상한 50 km/h, UGV 보다 낮은 가감속.
# 물 분사·탱크 기능 없음 (주행만).
# 설치: ugv/tools/px4-start.sh 가 PX4 빌드 폴더(build/px4_sitl_default/etc/init.d-posix/airframes)에 복사한다.

. ${R}etc/init.d/rc.rover_ackermann_defaults

PX4_SIMULATOR=${PX4_SIMULATOR:=gz}
PX4_GZ_WORLD=${PX4_GZ_WORLD:=adair_flat}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=adair_firetruck}

param set-default SIM_GZ_EN 1

# 웨이포인트 도착 반경 (m)
param set-default NAV_ACC_RAD 3
# 첫 웨이포인트 거리 검사 끔: 차량이 홈에서 수 km 떨어진 곳에서 새 경로를 받는다 (기본값이면 미션 시작 거부, 2026-10-09 실측)
param set-default MIS_DIST_1WP 0

# Ackermann: 축간거리·조향 (모델과 같은 값)
param set-default RA_WHEEL_BASE 3.8
param set-default RA_MAX_STR_ANG 0.6109
param set-default RA_STR_RATE_LIM 90
# RA_ACC_RAD_MAX -1: 꺾임각에 따라 도착 허용반경을 넓히는 기능(모서리 질러가기)을 끈다. 기본 도착 허용반경 NAV_ACC_RAD(3 m)는
# 그대로 남는다 — 지점을 정확히 지나도록 강제하는 설정은 아니다. 꺾이는 곳은 UGV 계획이 원호로 촘촘히 그려 주고
# (ugv/drive_graph.py _smooth, check_route) PX4 는 그 점들을 따라간다. 켜 두면(GAIN 2, MAX 15) 45° 꺾임에서 약 4.5 m,
# 90° 에서 약 11 m 앞부터 안쪽으로 질러간다 (2026-10-10)
param set-default RA_ACC_RAD_GAIN 1
param set-default RA_ACC_RAD_MAX -1

# 방향 제어
param set-default RO_YAW_P 3
param set-default RO_YAW_RATE_P 0.25
param set-default RO_YAW_RATE_I 0.01
param set-default RO_YAW_RATE_LIM 40
param set-default RO_YAW_ACCEL_LIM 120
param set-default RO_YAW_DECEL_LIM 120
param set-default RO_YAW_RATE_CORR 1
param set-default RO_YAW_EXPO 0.85
param set-default RO_YAW_SUPEXPO 0.3

# 속도 제어
#   RO_MAX_THR_SPEED: 최대 스로틀일 때 속도 = 바퀴 최대 35 rad/s × 반지름 0.5 m = 17.5 m/s
#   RO_SPEED_LIM   : 차량 속도 상한 13.9 m/s (50 km/h, 시뮬레이션 가정값)
#   RO_SPEED_RED   : 진행 방향 오차·꺾임 각에 따른 감속 (웨이포인트 도착 속도에도 쓰인다)
param set-default RO_MAX_THR_SPEED 17.5
param set-default RO_SPEED_LIM 13.9
param set-default RO_SPEED_P 0.1
param set-default RO_SPEED_I 0.01
param set-default RO_ACCEL_LIM 1.5
param set-default RO_DECEL_LIM 2.5
param set-default RO_JERK_LIM 3
param set-default RO_SPEED_RED 2.0

# 경로 추종 (pure pursuit): 앞보기 거리 = 속도 × 0.6 s, 2 ~ 15 m (1 s·25 m 일 때 45° 꺾임에서 바깥으로 6.5 m 밀림, 2026-10-09)
param set-default PP_LOOKAHD_GAIN 0.6
param set-default PP_LOOKAHD_MIN 4
param set-default PP_LOOKAHD_MAX 15

# Gazebo 출력: 바퀴 (값 - 100 = rad/s → ±35 rad/s), 조향 서보 ±35°
param set-default SIM_GZ_WH_FUNC1 101
param set-default SIM_GZ_WH_MIN1 65
param set-default SIM_GZ_WH_MAX1 135
param set-default SIM_GZ_WH_DIS1 100
param set-default SIM_GZ_SV_MAXA1 35
param set-default SIM_GZ_SV_MINA1 -35
param set-default CA_SV_CS_COUNT 1
param set-default SIM_GZ_SV_FUNC1 201
param set-default SIM_GZ_SV_REV 1
