<!-- 소방차 장식 (경광등·방수포). ugv/tools/make_fire_truck.py 가 PX4 기반 rover 모델(model.sdf)을 복사해
     마지막 </model> 앞에 이 링크·조인트를 넣는다. 자리표시: @BASE_LINK@ 차체 링크, @RID@ 자원, @FX@ 텍스처 폴더.
     경광등·물줄기는 particle emitter — 서버(ugv/gz_fx.py)가 /ugv/fx/<자원>/siren|water 토픽으로 켜고 끈다.
     물리에는 영향이 없다 (fx_link 는 아주 가벼운 링크, 충돌 없음). -->
    <link name="fx_link">
      <pose relative_to="@BASE_LINK@">0 0 0.30 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="light_bar">
        <pose>0 0 0.04 0 0 0</pose>
        <geometry><box><size>0.14 0.42 0.07</size></box></geometry>
        <material><ambient>0.8 0.05 0.05 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse><emissive>0.6 0 0 1</emissive></material>
      </visual>
      <visual name="cannon_base">
        <pose>0.18 0 0.05 0 0 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>0.08</length></cylinder></geometry>
        <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
      </visual>
      <visual name="cannon_barrel">
        <pose>0.30 0 0.12 0 -1.0 0</pose>
        <geometry><cylinder><radius>0.02</radius><length>0.26</length></cylinder></geometry>
        <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
      </visual>
      <particle_emitter name="siren" type="box">
        <pose>0 0 0.10 0 -1.5708 0</pose>
        <emitting>false</emitting>
        <topic>/ugv/fx/@RID@/siren</topic>
        <size>0.05 0.4 0.12</size>
        <particle_size>0.22 0.22 0.22</particle_size>
        <lifetime>0.5</lifetime>
        <rate>18</rate>
        <min_velocity>0.05</min_velocity>
        <max_velocity>0.2</max_velocity>
        <scale_rate>0.5</scale_rate>
        <material>
          <diffuse>1 1 1</diffuse>
          <pbr><metal><albedo_map>@FX@/blob.png</albedo_map></metal></pbr>
        </material>
        <color_range_image>@FX@/siren_colors.png</color_range_image>
      </particle_emitter>
      <particle_emitter name="water" type="box">
        <pose>0.40 0 0.20 0 -0.6 0</pose>
        <emitting>false</emitting>
        <topic>/ugv/fx/@RID@/water</topic>
        <size>0.05 0.05 0.05</size>
        <particle_size>0.12 0.12 0.12</particle_size>
        <lifetime>1.2</lifetime>
        <rate>80</rate>
        <min_velocity>5</min_velocity>
        <max_velocity>7</max_velocity>
        <scale_rate>1.2</scale_rate>
        <material>
          <diffuse>1 1 1</diffuse>
          <pbr><metal><albedo_map>@FX@/blob.png</albedo_map></metal></pbr>
        </material>
        <color_range_image>@FX@/water_colors.png</color_range_image>
      </particle_emitter>
    </link>
    <joint name="fx_joint" type="fixed">
      <parent>@BASE_LINK@</parent>
      <child>fx_link</child>
    </joint>
