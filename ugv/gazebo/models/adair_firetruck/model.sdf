<?xml version="1.0" ?>
<!--
  adair_firetruck — 시뮬레이션 전용 소방차 (2026-10-10). adair_ugv 와 같은 PX4 rover_ackermann 인터페이스·관절 이름을 쓴다:
    바퀴 속도 /model/<이름>/command/motor_speed, 조향 /model/<이름>/servo_0, 센서 air_pressure·magnetometer·imu·navsat.
  외형: 빨간 차대·운전석·장비 적재함, 흰 띠, 회색 사다리, 경광등 (시각 표시만).
  치수·질량은 **시뮬레이션용 가정값** (국내 중형 펌프차 규모 참고, 특정 실차 제원 아님 — ugv/profiles.py adair_firetruck):
    길이 7.0 m, 폭 2.3 m, 축간거리 3.8 m (앞축 차체 중심 +2.2 m, 뒤축 −1.6 m), 윤거 2.0 m, 바퀴 반지름 0.5 m,
    최대 조향 ±35° (뒤축 최소 회전반경 약 5.4 m), 차체 9,500 kg + 바퀴 80 kg × 4 ≈ 9.8 t, 무게중심 지면 위 약 1.1 m.
  물 분사·물탱크·호스·진화 효과는 없다 (주행 모델).
  최고 바퀴 속도는 airframe 51101_gz_adair_firetruck 의 SIM_GZ_WH_MIN1/MAX1 (±35 rad/s ≈ 17.5 m/s), 속도 상한 13.9 m/s (50 km/h).
-->
<sdf version="1.9">
  <model name="adair_firetruck">
    <link name="base_link">
      <pose relative_to="__model__">0 0 0.5 0 0 0</pose>
      <inertial>
        <pose>0 0 0.6 0 0 0</pose>
        <mass>9500.0</mass>
        <inertia>
          <ixx>7355</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>41958</iyy><iyz>0</iyz>
          <izz>42980</izz>
        </inertia>
      </inertial>
      <visual name="chassis_visual">
        <pose>0 0 0.1 0 0 0</pose>
        <geometry><box><size>7.0 2.3 0.5</size></box></geometry>
        <material><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
      <visual name="cab_visual">
        <pose>2.6 0 1.1 0 0 0</pose>
        <geometry><box><size>1.8 2.3 1.5</size></box></geometry>
        <material><diffuse>0.85 0.05 0.05 1</diffuse><specular>0.4 0.4 0.4 1</specular></material>
      </visual>
      <visual name="windshield_visual">
        <pose>3.51 0 1.35 0 0 0</pose>
        <geometry><box><size>0.02 2.0 0.7</size></box></geometry>
        <material><diffuse>0.2 0.3 0.4 1</diffuse></material>
      </visual>
      <visual name="body_visual">
        <pose>-0.9 0 1.15 0 0 0</pose>
        <geometry><box><size>5.2 2.3 1.6</size></box></geometry>
        <material><diffuse>0.85 0.05 0.05 1</diffuse><specular>0.4 0.4 0.4 1</specular></material>
      </visual>
      <visual name="stripe_visual">
        <pose>0 0 0.75 0 0 0</pose>
        <geometry><box><size>7.02 2.32 0.15</size></box></geometry>
        <material><diffuse>0.95 0.95 0.95 1</diffuse></material>
      </visual>
      <visual name="ladder_visual">
        <pose>-0.6 0 2.05 0 0 0</pose>
        <geometry><box><size>5.6 0.6 0.15</size></box></geometry>
        <material><diffuse>0.7 0.7 0.72 1</diffuse></material>
      </visual>
      <visual name="lightbar_visual">
        <pose>2.9 0 1.92 0 0 0</pose>
        <geometry><box><size>0.3 1.4 0.12</size></box></geometry>
        <material><diffuse>0.1 0.2 1.0 1</diffuse><emissive>0.1 0.2 0.8 1</emissive></material>
      </visual>
      <collision name="body_collision">
        <pose>0 0 0.9 0 0 0</pose>
        <geometry><box><size>7.0 2.3 2.0</size></box></geometry>
      </collision>

      <!-- 센서 (rover_ackermann 과 같은 설정) -->
      <sensor name="air_pressure_sensor" type="air_pressure">
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <pressure><noise type="gaussian"><mean>0</mean><stddev>3</stddev></noise></pressure>
        </air_pressure>
      </sensor>
      <sensor name="magnetometer_sensor" type="magnetometer">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <magnetometer>
          <x><noise type="gaussian"><stddev>0.0001</stddev></noise></x>
          <y><noise type="gaussian"><stddev>0.0001</stddev></noise></y>
          <z><noise type="gaussian"><stddev>0.0001</stddev></noise></z>
        </magnetometer>
      </sensor>
      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0008726646</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0008726646</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0008726646</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.00637</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.00637</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.00686</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
      <sensor name="navsat_sensor" type="navsat">
        <always_on>1</always_on>
        <update_rate>30</update_rate>
      </sensor>
    </link>

    <!-- 뒷바퀴 -->
    <link name="wheel_rear_left_link">
      <pose relative_to="base_link">-1.6 1.0 0 -1.5707963 0 0</pose>
      <inertial>
        <mass>80.0</mass>
        <inertia><ixx>5.82</ixx><ixy>0</ixy><ixz>0</ixz><iyy>5.82</iyy><iyz>0</iyz><izz>10.0</izz></inertia>
      </inertial>
      <visual name="visual">
        <geometry><cylinder><radius>0.5</radius><length>0.35</length></cylinder></geometry>
        <material><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <collision name="collision">
        <geometry><cylinder><radius>0.5</radius><length>0.35</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2><fdir1>1 0 0</fdir1></ode></friction></surface>
      </collision>
    </link>
    <link name="wheel_rear_right_link">
      <pose relative_to="base_link">-1.6 -1.0 0 -1.5707963 0 0</pose>
      <inertial>
        <mass>80.0</mass>
        <inertia><ixx>5.82</ixx><ixy>0</ixy><ixz>0</ixz><iyy>5.82</iyy><iyz>0</iyz><izz>10.0</izz></inertia>
      </inertial>
      <visual name="visual">
        <geometry><cylinder><radius>0.5</radius><length>0.35</length></cylinder></geometry>
        <material><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <collision name="collision">
        <geometry><cylinder><radius>0.5</radius><length>0.35</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2><fdir1>1 0 0</fdir1></ode></friction></surface>
      </collision>
    </link>

    <!-- 앞바퀴: 조향 링크(차체 기준 z축 회전) → 바퀴 링크(y축 회전) -->
    <link name="wheel_front_left_steering_link">
      <pose relative_to="base_link">2.2 1.0 0 0 0 0</pose>
      <inertial>
        <mass>2.0</mass>
        <inertia><ixx>0.01</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.01</iyy><iyz>0</iyz><izz>0.01</izz></inertia>
      </inertial>
    </link>
    <link name="wheel_front_right_steering_link">
      <pose relative_to="base_link">2.2 -1.0 0 0 0 0</pose>
      <inertial>
        <mass>2.0</mass>
        <inertia><ixx>0.01</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.01</iyy><iyz>0</iyz><izz>0.01</izz></inertia>
      </inertial>
    </link>
    <link name="wheel_front_left_link">
      <pose relative_to="base_link">2.2 1.0 0 -1.5707963 0 0</pose>
      <inertial>
        <mass>80.0</mass>
        <inertia><ixx>5.82</ixx><ixy>0</ixy><ixz>0</ixz><iyy>5.82</iyy><iyz>0</iyz><izz>10.0</izz></inertia>
      </inertial>
      <visual name="visual">
        <geometry><cylinder><radius>0.5</radius><length>0.35</length></cylinder></geometry>
        <material><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <collision name="collision">
        <geometry><cylinder><radius>0.5</radius><length>0.35</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2><fdir1>1 0 0</fdir1></ode></friction></surface>
      </collision>
    </link>
    <link name="wheel_front_right_link">
      <pose relative_to="base_link">2.2 -1.0 0 -1.5707963 0 0</pose>
      <inertial>
        <mass>80.0</mass>
        <inertia><ixx>5.82</ixx><ixy>0</ixy><ixz>0</ixz><iyy>5.82</iyy><iyz>0</iyz><izz>10.0</izz></inertia>
      </inertial>
      <visual name="visual">
        <geometry><cylinder><radius>0.5</radius><length>0.35</length></cylinder></geometry>
        <material><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <collision name="collision">
        <geometry><cylinder><radius>0.5</radius><length>0.35</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2><fdir1>1 0 0</fdir1></ode></friction></surface>
      </collision>
    </link>

    <!-- 관절 -->
    <joint name="wheel_rear_left_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheel_rear_left_link</child>
      <axis><xyz expressed_in="__model__">0 1 0</xyz></axis>
    </joint>
    <joint name="wheel_rear_right_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheel_rear_right_link</child>
      <axis><xyz expressed_in="__model__">0 1 0</xyz></axis>
    </joint>
    <joint name="wheel_front_left_steering_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheel_front_left_steering_link</child>
      <axis>
        <xyz expressed_in="__model__">0 0 1</xyz>
        <limit><lower>-0.6109</lower><upper>0.6109</upper><effort>1e6</effort></limit>
      </axis>
    </joint>
    <joint name="wheel_front_right_steering_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheel_front_right_steering_link</child>
      <axis>
        <xyz expressed_in="__model__">0 0 1</xyz>
        <limit><lower>-0.6109</lower><upper>0.6109</upper><effort>1e6</effort></limit>
      </axis>
    </joint>
    <joint name="wheel_front_left_joint" type="revolute">
      <parent>wheel_front_left_steering_link</parent>
      <child>wheel_front_left_link</child>
      <axis><xyz expressed_in="__model__">0 1 0</xyz></axis>
    </joint>
    <joint name="wheel_front_right_joint" type="revolute">
      <parent>wheel_front_right_steering_link</parent>
      <child>wheel_front_right_link</child>
      <axis><xyz expressed_in="__model__">0 1 0</xyz></axis>
    </joint>

    <!-- 바퀴 속도: PX4 가 보내는 actuator 0 (rad/s) 을 네 바퀴에 그대로 -->
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>wheel_rear_left_joint</joint_name>
      <sub_topic>command/motor_speed</sub_topic>
      <control_type>velocity</control_type>
      <use_actuator_msg>true</use_actuator_msg>
      <actuator_number>0</actuator_number>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>wheel_rear_right_joint</joint_name>
      <sub_topic>command/motor_speed</sub_topic>
      <control_type>velocity</control_type>
      <use_actuator_msg>true</use_actuator_msg>
      <actuator_number>0</actuator_number>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>wheel_front_left_joint</joint_name>
      <sub_topic>command/motor_speed</sub_topic>
      <control_type>velocity</control_type>
      <use_actuator_msg>true</use_actuator_msg>
      <actuator_number>0</actuator_number>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>wheel_front_right_joint</joint_name>
      <sub_topic>command/motor_speed</sub_topic>
      <control_type>velocity</control_type>
      <use_actuator_msg>true</use_actuator_msg>
      <actuator_number>0</actuator_number>
    </plugin>

    <!-- 조향: PX4 servo_0 (rad). 속도 명령 방식이라 바퀴 질량에 관계없이 진동 없이 따라간다. 조향 속도 상한 2 rad/s -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>wheel_front_left_steering_joint</joint_name>
      <sub_topic>servo_0</sub_topic>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>15</p_gain>
      <i_gain>0</i_gain>
      <d_gain>0</d_gain>
      <cmd_max>2.0</cmd_max>
      <cmd_min>-2.0</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>wheel_front_right_steering_joint</joint_name>
      <sub_topic>servo_0</sub_topic>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>15</p_gain>
      <i_gain>0</i_gain>
      <d_gain>0</d_gain>
      <cmd_max>2.0</cmd_max>
      <cmd_min>-2.0</cmd_min>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>wheel_rear_left_joint</joint_name>
      <joint_name>wheel_rear_right_joint</joint_name>
      <joint_name>wheel_front_left_joint</joint_name>
      <joint_name>wheel_front_right_joint</joint_name>
      <joint_name>wheel_front_left_steering_joint</joint_name>
      <joint_name>wheel_front_right_steering_joint</joint_name>
    </plugin>
  </model>
</sdf>
